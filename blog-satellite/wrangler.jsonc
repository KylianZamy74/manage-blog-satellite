{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manage-blog-satellite",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "manage-blog-satellite"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "blog-satellite-images",
      // dev (next dev / preview) also writes to the real bucket, so served URLs work locally
      "remote": true
    }
  ],
  "vars": {
    "R2_PUBLIC_URL": "https://images.page-satellite.com"
  },
  "observability": {
    "enabled": true
  }
}
